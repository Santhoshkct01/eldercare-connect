{
  "name": "eldercare-connect-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Smart Elderly Assistance Platform",
  "scripts": {
    "install:server": "npm --prefix server install --include=dev",
    "install:client": "npm --prefix client install --include=dev",
    "install:all": "npm run install:server && npm run install:client",
    "build": "npm run install:client && npm --prefix client run build",
    "start": "npm --prefix server start",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "test": "npm --prefix server test"
  },
  "keywords": [
    "eldercare",
    "assistance",
    "mern",
    "socketio"
  ],
  "author": "Eldercare Connect Team",
  "license": "ISC"
}
